# Supabase is optional for local demo mode, but required for persistent storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider secrets are referenced by env name and never committed.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Eval safeguards.
AGENTEVAL_MAX_CASES=100
AGENTEVAL_REQUEST_TIMEOUT_MS=60000
